; Engine configuration file.
; Godot 4.7

config_version=5

[application]

config/name="VR Drums"
config/description="Play a drum kit in VR. OpenXR: PSVR2 (PC adapter), Index, Vive, Quest/Pico via Link, WMR."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

driver/mix_rate=48000
driver/output_latency=10

[autoload]

DrumAudio="*res://scripts/audio/drum_audio.gd"
Settings="*res://scripts/settings/settings.gd"

[rendering]

anti_aliasing/quality/msaa_3d=2

[xr]

openxr/enabled=true
openxr/default_action_map="res://openxr_action_map.tres"
shaders/enabled=true
